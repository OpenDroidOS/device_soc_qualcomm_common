config("dma_heap_headers") {
  include_dirs = [ "include" ]
}

source_set("dma_heap") {
  sources = [
    "display/memory/dma_heap.cpp",
    "include/qcom/dma_heap.h",
  ]
  public = [ "include/qcom/dma_heap.h" ]
  public_configs = [ ":dma_heap_headers" ]
  cflags_cc = [ "-std=c++17" ]
}

config("native_buffer_headers") {
  include_dirs = [
    "include",
    "//drivers/hdf_core/interfaces/inner_api/hdi/base",
    "//interface/sdk_c/graphic/graphic_2d",
    "//third_party/libdrm/include/drm",
  ]
}

source_set("native_buffer_export") {
  sources = [ "display/memory/native_buffer_export.cpp" ]
  public = [
    "include/qcom/native_buffer.h",
    "include/qcom/native_buffer_export.h",
  ]
  public_configs = [ ":native_buffer_headers" ]
  public_deps = [ ":dma_heap" ]
  cflags_cc = [ "-std=c++17" ]
}

source_set("vulkan_buffer_allocator") {
  sources = [ "display/memory/vulkan_buffer_allocator.cpp" ]
  public = [ "include/qcom/vulkan_buffer_allocator.h" ]
  public_deps = [ ":native_buffer_export" ]
  include_dirs = [
    "//third_party/vulkan-headers/include",
    "//drivers/peripheral/display/interfaces/include",
  ]
  libs = [ "dl" ]
  cflags_cc = [ "-std=c++17" ]
}

source_set("native_buffer_metadata") {
  sources = [ "display/memory/buffer_metadata.cpp" ]
  public = [ "include/qcom/buffer_metadata.h" ]
  public_deps = [ ":native_buffer_export" ]
  include_dirs = [ "//foundation/graphic/graphic_surface/interfaces/inner_api/buffer_handle" ]
  cflags_cc = [ "-std=c++17" ]
}
