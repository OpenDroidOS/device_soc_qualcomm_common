import("//build/ohos.gni")
import("../config.gni")

ohos_static_library("buffer_metadata") {
  public_deps = [ "../..:native_buffer_metadata" ]
  complete_static_lib = true
  subsystem_name = "hdf"
  part_name = "qcom_display"
}

ohos_shared_library("display_buffer_vdi_impl") {
  sources = [ "display_buffer_vdi.cpp" ]
  deps = [
    "../..:native_buffer_metadata",
    "../..:vulkan_buffer_allocator",
  ]
  # External renderers consume the complete archive; the VDI already shares
  # the allocator's source-set dependencies and must not link them twice.
  data_deps = [ ":buffer_metadata" ]
  include_dirs = [
    "//drivers/peripheral/display/buffer/hdi_service/include",
    "//drivers/peripheral/display/interfaces/include",
  ]
  external_deps = [
    "drivers_interface_display:libdisplay_buffer_stub_1.2",
    "hdf_core:libhdf_utils",
  ]
  install_enable = qcom_display_native_buffer
  install_images = [ "vendor" ]
  subsystem_name = "hdf"
  part_name = "qcom_display"
}
